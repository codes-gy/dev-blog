// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    //url      = env("DATABASE_URL")
}

model Post {
    id        BigInt   @id @default(autoincrement())
    slug      String   @unique // 노션 포스트의 고유 주소
    views     Int      @default(0) // 기본 조회수 0
    likes     Int      @default(0) // 기본 좋아요 수 0
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Contact {
    id      BigInt @id @default(autoincrement())
    name    String // 문의자 이름 또는 닉네임
    email   String // 회신받을 이메일 주소
    subject String // 문의 제목
    message String @db.Text // 문의 내용 (긴 텍스트를 저장하기 위해 @db.Text 지정)

    // 💡 운영 관리 생산성을 위한 권장 필드
    isProcessed Boolean @default(false) // 답변 처리 완료 여부 (기본값: false)

    createdAt DateTime @default(now()) // 문의 접수 일시
    updatedAt DateTime @updatedAt // 관리 상태 수정 일시
}
